# Local Google OAuth web client credentials.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
MEET_MONITOR_SECRET=replace-with-a-long-random-secret
PRESENCE_API_TOKEN=replace-with-a-long-random-token

# Optional: use PostgreSQL locally; omit for SQLite development.
# DATABASE_URL=postgresql://user:password@localhost:5432/meet_monitor

# Local callback URL: http://localhost:5000/auth/google/callback
# Hosted callback URL: https://YOUR-SERVICE.onrender.com/auth/google/callback
